{
  "name": "my_portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "George Shenoda portfolio — website",
  "author": "George Shenoda <general@email.com>",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @portfolio/web",
    "build": "npm run build -w @portfolio/web",
    "start": "npm run start -w @portfolio/web",
    "lint": "npm run lint -w @portfolio/web",
    "typecheck": "npm run typecheck -w @portfolio/web",
    "icons": "node scripts/make-icons.mjs",
    "shots": "node scripts/make-project-shots.mjs",
    "cv:pdf": "node scripts/make-cv-pdf.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:tests": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
