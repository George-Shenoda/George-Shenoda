{
  "name": "my_portfolio",
  "version": "0.1.1",
  "private": true,
  "description": "George Shenoda portfolio — website, desktop and mobile apps",
  "author": "George Shenoda <general@email.com>",
  "main": "apps/desktop/electron/main.mjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @portfolio/web",
    "build": "npm run build -w @portfolio/web",
    "start": "npm run start -w @portfolio/web",
    "lint": "npm run lint -w @portfolio/web",
    "typecheck": "npm run typecheck -w @portfolio/web",
    "icons": "node scripts/make-icons.mjs",
    "shots": "node scripts/make-project-shots.mjs",
    "cv:pdf": "node scripts/make-cv-pdf.mjs",
    "desktop:dev": "npm run dev -w @portfolio/desktop",
    "desktop:build": "cross-env ELECTRON_BUILD=true npm run build -w @portfolio/web && npm run assemble -w @portfolio/desktop",
    "desktop:dist": "npm run desktop:build && electron-builder"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0"
  }
}
